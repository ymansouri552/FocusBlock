    <!-- Play disclosure -->
    <string name="play_disclosure_body">FocusBlock requests Accessibility Service and Device Administrator permissions. Accessibility is used only to detect when a blocked app is brought to the foreground so the block screen can be shown. No screen content is collected, stored, or transmitted. Device Administrator is used only to prevent uninstallation of FocusBlock while a Strict Mode block is active. You can revoke either permission at any time in Settings.</string>
    <string name="play_disclosure_accessibility">I consent to the Accessibility Service being used to detect blocked apps and enforce blocks locally on this device.</string>
    <string name="play_disclosure_device_admin">I consent to Device Administrator being used to prevent uninstallation while Strict Mode is active.</string>
