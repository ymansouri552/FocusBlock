        <item name="colorOnPrimary">@color/m3_refresh_onPrimary</item>
        <item name="colorOnPrimaryContainer">@color/m3_refresh_onPrimaryContainer</item>
        <item name="colorOnSecondary">@color/m3_refresh_onSecondary</item>
